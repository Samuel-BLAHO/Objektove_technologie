<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.ot4.HelloController"
      spacing="5">

    <Button text="Pridať obdĺžnik"
            onAction="#pridajObdlznik"/>

    <Button text="Pridať kruh"
            onAction="#pridajKruh"/>

    <Button text="Pridať štvorec"
            onAction="#pridajStvorec"/>

    <Button text="Zmeniť kruhy na modré"
            onAction="#zmenKruhyNaModru"/>

    <Button text="Posunúť všetky nadol"
            onAction="#posunVsetkyDole"/>

    <Pane fx:id="plocha"
          prefWidth="600"
          prefHeight="400"/>
</VBox>